# Development Dockerfile for the Rails API backend.
# (The plain "Dockerfile" that Rails generated alongside this one is meant for
# production deployment - we use this simpler one for local development.)
FROM ruby:3.3-slim

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    default-libmysqlclient-dev \
    pkg-config \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install gems first so this layer is cached unless Gemfile changes
COPY Gemfile Gemfile.lock ./
RUN bundle install

# Copy the rest of the app (also overridden by the bind mount in docker-compose
# during development, so edits on your machine show up immediately)
COPY . .

EXPOSE 3000

CMD ["bin/rails", "server", "-b", "0.0.0.0"]
